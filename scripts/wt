#!/usr/bin/env bash
# Ciclo de worktrees por feature. `wt new` crea rama y carpeta. `wt done` borra ambas
# solo si no hay cambios sin commit y la rama ya entró a main.
#   wt new <feature>    crea ../absolut-cinema-<feature> desde main
#   wt integrate <feature>  merge de la rama a main, en la carpeta principal
#   wt done <feature>   borra el worktree y la rama
#   wt list             muestra cada worktree con su estado
#   wt slot             número de esta carpeta para los puertos: 0 en main, 1 el primer worktree, 2 el segundo…
set -euo pipefail

# La primera entrada de `worktree list` es la carpeta principal, aunque se ejecute desde otro worktree.
ROOT=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')

die() {
  echo "wt: $*" >&2
  exit 1
}

dir_for() {
  echo "$(dirname "$ROOT")/absolut-cinema-$1"
}

# Una rama entró a main si su merge es local, o si su PR se mergeó con squash.
integrated() {
  local feature=$1 dir=$2
  git -C "$ROOT" merge-base --is-ancestor "$feature" main 2>/dev/null && return 0
  local merged
  merged=$(cd "$dir" && gh pr list --head "$feature" --state merged --json number --jq 'length' 2>/dev/null || echo 0)
  [ "$merged" -gt 0 ]
}

new() {
  local feature=${1:?Uso: wt new <feature>}
  local dir
  dir=$(dir_for "$feature")
  [ ! -e "$dir" ] || die "ya existe $dir"
  git -C "$ROOT" worktree add -b "$feature" "$dir" main
  # Datos y entorno de la carpeta principal, para correr `make dashboard` y `make dashboard-dev` aquí mismo.
  ln -s "$ROOT/data" "$dir/data"
  ln -s "$ROOT/.venv" "$dir/.venv"
  (cd "$dir/dashboard" && pnpm install --frozen-lockfile --silent) || echo "wt: pnpm install falló; corre pnpm install en $dir/dashboard"
  echo "Listo: $dir (rama $feature)"
}

# La carpeta principal debe ser un checkout de main, limpio y sin ser un repo "bare". Si no, un merge deja los archivos
# atrasados respecto a `main` y el índice muestra el inverso del último commit.
main_folder_problem() {
  [ "$(git -C "$ROOT" config --bool core.bare)" != true ] || { echo "core.bare es true; corrige con: git config core.bare false"; return; }
  [ "$(git -C "$ROOT" symbolic-ref --short HEAD 2>/dev/null)" = main ] || { echo "la carpeta principal no está en main"; return; }
  [ -z "$(git -C "$ROOT" status --porcelain --untracked-files=no)" ] || echo "la carpeta principal tiene cambios sin commit"
}

integrate() {
  local feature=${1:?Uso: wt integrate <feature>}
  local dir problem
  dir=$(dir_for "$feature")
  [ -d "$dir" ] || die "no existe $dir"
  [ -z "$(git -C "$dir" status --porcelain)" ] || die "$feature tiene cambios sin commit"
  problem=$(main_folder_problem)
  [ -z "$problem" ] || die "$problem"
  git -C "$ROOT" merge "$feature"
  echo "Listo: $feature está en main. Siguiente: wt done $feature"
}

done_wt() {
  local feature=${1:?Uso: wt done <feature>}
  local dir
  dir=$(dir_for "$feature")
  [ "$feature" != main ] || die "main no se borra"
  [ -d "$dir" ] || die "no existe $dir"
  [ -z "$(git -C "$dir" status --porcelain)" ] || die "$feature tiene cambios sin commit"
  integrated "$feature" "$dir" || die "$feature no ha entrado a main (merge o PR pendiente)"

  git -C "$ROOT" worktree remove "$dir"
  # Con squash el commit de la rama no es ancestro de main, por eso `-d` fallaría.
  # La condición de `integrated` ya se verificó, así que se fuerza.
  if git -C "$ROOT" merge-base --is-ancestor "$feature" main 2>/dev/null; then
    git -C "$ROOT" branch -d "$feature"
  else
    git -C "$ROOT" branch -D "$feature"
  fi
  echo "Borrado: $dir y rama $feature"
}

list() {
  local problem
  problem=$(main_folder_problem)
  [ -z "$problem" ] || echo "AVISO: $problem"
  git -C "$ROOT" worktree list --porcelain | awk '/^worktree /{print $2}' | while read -r wt; do
    [ "$wt" != "$ROOT" ] || continue
    local branch dirty state
    branch=$(git -C "$wt" symbolic-ref --short HEAD 2>/dev/null || echo detached)
    dirty=$(git -C "$wt" status --porcelain | wc -l | tr -d ' ')
    if git -C "$ROOT" merge-base --is-ancestor "$branch" main 2>/dev/null; then
      state="en main"
    else
      state="pendiente"
    fi
    echo "$branch | sin commit: $dirty | $state | $wt"
  done
}

# Los puertos de desarrollo salen de este número (AGENTS.md, "Puertos de desarrollo").
slot() {
  local here n=0 wt
  here=$(git rev-parse --show-toplevel)
  [ "$here" != "$ROOT" ] || { echo 0; return; }
  while read -r wt; do
    [ "$wt" != "$ROOT" ] || continue
    n=$((n + 1))
    [ "$wt" != "$here" ] || { echo "$n"; return; }
  done < <(git worktree list --porcelain | awk '/^worktree /{print $2}')
  die "esta carpeta no es un worktree conocido"
}

case "${1:-}" in
  new) shift; new "$@" ;;
  integrate) shift; integrate "$@" ;;
  done) shift; done_wt "$@" ;;
  list) list ;;
  slot) slot ;;
  *) die "uso: wt new <feature> | wt integrate <feature> | wt done <feature> | wt list | wt slot" ;;
esac
